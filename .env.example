# Runtime
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web applications
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# Platform services
GENERATION_API_URL=http://localhost:4100
MODEL_GATEWAY_URL=http://localhost:4200
AUDIO_PROCESSING_URL=http://localhost:4300
AUDIO_PROCESSING_PUBLIC_URL=http://localhost:4300
MEDIA_INGESTION_URL=http://localhost:4400

# Data / durable queue
DATABASE_URL=postgresql://allatyme:allatyme@localhost:5432/allatyme
REDIS_URL=redis://localhost:6379
GENERATION_QUEUE_KEY=allatyme:generation:queued
DB_POOL_MAX=10

# Object storage (local MinIO defaults; replace in production)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=allatyme-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PUBLIC_BASE_URL=
MEDIA_SOURCE_ALLOWLIST=http://localhost:4300
MEDIA_INGEST_MAX_BYTES=536870912

# Model runtime
MODEL_PROVIDER=ace-step
MODEL_RUNTIME_URL=http://localhost:8001
MODEL_RUNTIME_TOKEN=
ACESTEP_MODEL=acestep-v15-xl-turbo
AUDIO_SOURCE_ALLOWLIST=http://localhost:8001
AUDIO_SOURCE_MAX_BYTES=536870912
FFMPEG_PATH=ffmpeg

# Worker
WORKER_POLL_MS=2000
PROVIDER_POLL_MS=3000
PROVIDER_TIMEOUT_MS=1200000

# Security - set strong secrets outside local development
SESSION_SECRET=
INTERNAL_SERVICE_TOKEN=

# Rights and policy
REQUIRE_TRAINING_RIGHTS_ATTESTATION=true
ALLOW_EXTERNAL_REFERENCE_AUDIO=false
