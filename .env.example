# Runtime
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web applications
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# Platform services
GENERATION_API_URL=http://localhost:4100
MODEL_GATEWAY_URL=http://localhost:4200
AUDIO_PROCESSING_URL=http://localhost:4300
MEDIA_INGESTION_URL=http://localhost:4400

# Data
DATABASE_URL=postgresql://allatyme:allatyme@localhost:5432/allatyme
REDIS_URL=redis://localhost:6379

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Model runtime
MODEL_PROVIDER=local
MODEL_RUNTIME_URL=
MODEL_RUNTIME_TOKEN=

# Security
SESSION_SECRET=
INTERNAL_SERVICE_TOKEN=

# Rights and policy
REQUIRE_TRAINING_RIGHTS_ATTESTATION=true
ALLOW_EXTERNAL_REFERENCE_AUDIO=false
