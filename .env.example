# ALLAFLUX canonical identity
ALLAFLUX_ODIN=ODIN-P-AE1001
ALLAFLUX_REGISTRY_KEY=allaflux
ALLAFLUX_CANONICAL_URL=https://flux.allatyme.com
ALLAFLUX_API_URL=https://api.allatyme.com
ALLAFLUX_RECORD_DATE=2026-09-12

# Runtime
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Local web applications
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# Canonical public production nodes
PUBLIC_WEB_URL=https://flux.allatyme.com
PUBLIC_API_URL=https://api.allatyme.com

# Platform services - local/private service boundaries
# These do not require separate public DNS names in the current production architecture.
GENERATION_API_URL=http://localhost:4100
MODEL_GATEWAY_URL=http://localhost:4200
AUDIO_PROCESSING_URL=http://localhost:4300
AUDIO_PROCESSING_PUBLIC_URL=https://api.allatyme.com
MEDIA_INGESTION_URL=http://localhost:4400

# Sites/audio bridge when this source is used with the canonical deployment
AUDIO_ENGINE_URL=https://api.allatyme.com
AUDIO_ENGINE_TOKEN=
ENGINE_TOKEN=

# Data / durable queue
DATABASE_URL=postgresql://allatyme:allatyme@localhost:5432/allatyme
REDIS_URL=redis://localhost:6379
GENERATION_QUEUE_KEY=allatyme:generation:queued
DB_POOL_MAX=10

# Object storage (local MinIO defaults; replace in production)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=allatyme-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PUBLIC_BASE_URL=https://api.allatyme.com/media
MEDIA_SOURCE_ALLOWLIST=http://localhost:4300,http://localhost:8001
MEDIA_INGEST_MAX_BYTES=536870912

# Model runtime - private/internal in production
MODEL_PROVIDER=ace-step
MODEL_RUNTIME_URL=http://localhost:8001
MODEL_RUNTIME_TOKEN=
ACESTEP_URL=http://localhost:8001
ACESTEP_API_KEY=
ACESTEP_MODEL=acestep-v15-xl-turbo
AUDIO_SOURCE_ALLOWLIST=http://localhost:8001
AUDIO_SOURCE_MAX_BYTES=536870912
FFMPEG_PATH=ffmpeg

# Worker
WORKER_POLL_MS=2000
PROVIDER_POLL_MS=3000
PROVIDER_TIMEOUT_MS=1200000

# Security - set strong secrets outside local development
SESSION_SECRET=
INTERNAL_SERVICE_TOKEN=

# Rights and policy
REQUIRE_TRAINING_RIGHTS_ATTESTATION=true
ALLOW_EXTERNAL_REFERENCE_AUDIO=false

# Reserved future public node: https://audioflux.allatyme.com
# It is not active or required in the current two-node architecture.
